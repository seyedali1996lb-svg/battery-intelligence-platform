FROM python:3.11-slim

WORKDIR /app

# requirements.txt now installs batlab itself via `-e .`, which needs
# pyproject.toml + batlab/ present before pip runs — copy those (and
# nothing else yet, to keep dependency-layer caching for everything else)
# ahead of the install step.
COPY requirements.txt pyproject.toml .
COPY batlab/ ./batlab/
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000
CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8000"]
