# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.env
.venv
venv/

# Data — large raw files stay local, not in git
data/raw/**/*.mat
data/raw/**/*.zip

# CALCE raw workbooks (manually placed, no small extracted CSVs committed
# for this loader — see batlab/datasets/calce.py). tests/fixtures/calce/
# is a separate path and is unaffected by this rule.
data/raw/calce/

# Synthetic cell disk-cache (auto-regenerated by src/data_loader.py, not source data)
data/raw/Cell*_summary.csv

# Trained model bundle cache (auto-regenerated by src/bundle_cache.py)
.cache/

# App persistence DB (decisions, cohort tags, settings, trajectory signatures)
data/app.db

# Per-organization uploaded fleet bundles (trained model + DataFrames, one per org)
data/tenant_bundles/

# Jupyter
.ipynb_checkpoints/

# mkdocs build output + the notebooks/ copy docs/hooks.py generates at build time
site/
docs/notebooks/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
