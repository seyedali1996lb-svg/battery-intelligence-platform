# Only needed for `npm run dev` — Vite's dev server on :5173 talking to the API
# on :8000 is the one cross-origin case.
#
# A production build needs no value here: `uvicorn src.api:app` serves the built
# assets from frontend/dist at /app, and src/api.ts falls back to a relative
# base URL, so the SPA and the API share an origin.
VITE_API_BASE_URL=http://localhost:8000
